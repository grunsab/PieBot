+    pub fn search_with_params(&mut self, board: &Board, params: SearchParams) -> SearchResult {
+        let threads = params.threads.max(1);
+        self.set_threads(threads);
+        let serial = SearchParams {
+            threads: 1,
+            ..params
+        };
+        let mut result = if params.use_tt
